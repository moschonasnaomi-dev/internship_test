# ---------------------------------------------------------------------------
# Internship Compass - environment variables (all optional)
# ---------------------------------------------------------------------------
# The app works with ZERO configuration: it calls the free anonymous
# Pollinations text endpoint (https://text.pollinations.ai/openai).
#
# 1) Optional: authenticate with Pollinations for higher rate limits.
#    Create a key at https://enter.pollinations.ai/keys  (starts with "sk_")
#    When set, the app switches to https://gen.pollinations.ai/v1/chat/completions
# POLLINATIONS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Optional: override the Pollinations text endpoint / model.
# POLLINATIONS_TEXT_URL=https://text.pollinations.ai/openai
# POLLINATIONS_MODEL=openai-fast
# POLLINATIONS_REFERRER=internship-compass.vercel.app

# 3) Optional: durable storage so edits survive cold starts on Vercel.
#    Add the Upstash Redis integration from the Vercel Marketplace and these
#    variables are injected automatically. Without them the API stores edits in
#    the ephemeral /tmp folder (see the banner in the UI).
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4) Optional: disable the deterministic fallback scorer (AI-only mode).
# ALLOW_HEURISTIC_FALLBACK=true
